# Copy this file to .env and edit values. .env is gitignored.
# These names match libpq environment variables:
# https://www.postgresql.org/docs/17/libpq-envars.html
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=change_me
PGDATABASE=pgcourse

# Optional: SQLAlchemy / asyncpg URLs assembled from the above.
DATABASE_URL=postgresql+psycopg://postgres:change_me@localhost:5432/pgcourse
DATABASE_URL_ASYNC=postgresql+asyncpg://postgres:change_me@localhost:5432/pgcourse
